<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/AnrLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/AppTheme">

 <!-- Focus Sink View -->
 <View
     android:id="@+id/focusSink"
     android:layout_width="10dp"
     android:layout_height="10dp"
     android:focusable="true"
     android:focusableInTouchMode="true"
     android:visibility="visible"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- Alarm History Button -->

 <!-- GPD Flow Data Button -->

 <Button
     android:id="@+id/alarmHistory"
     android:layout_width="100dp"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="8dp"
     android:background="@color/colorSendText"
     android:text="Alarm History"
     android:textColor="@color/design_default_color_on_secondary"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/ffTest" />

 <!-- Manual Inputs Button -->
 <Button
     android:id="@+id/flowData"
     android:layout_width="100dp"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:background="@color/light_blue_A200"
     android:text="GPD Flow Data"
     android:textAlignment="center"
     android:textColor="@color/design_default_color_on_secondary"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toEndOf="@+id/alarmHistory"
     app:layout_constraintTop_toTopOf="@+id/alarmHistory" />

 <!-- Time TextView -->

 <Button
     android:id="@+id/manualTest"
     android:layout_width="wrap_content"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:background="@color/light_blue_A200"
     android:text="Probe Status"
     android:textAlignment="center"
     android:textColor="@color/design_default_color_on_secondary"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toEndOf="@+id/flowData"
     app:layout_constraintTop_toTopOf="@+id/flowData" />

 <TextView
     android:id="@+id/timeRemote"
     android:layout_width="297dp"
     android:layout_height="56dp"
     android:layout_marginStart="8dp"
     android:layout_marginTop="16dp"
     android:maxLines="2"
     android:minLines="1"
     android:paddingStart="10dp"
     android:paddingTop="1dp"
     android:paddingEnd="10dp"
     android:paddingBottom="10dp"
     android:text="00:00:00"
     android:textColor="@android:color/secondary_text_dark"
     android:textSize="@dimen/timeTextSize"
     android:visibility="visible"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- Hoot Bug Image -->
 <ImageView
     android:id="@+id/hootBug"
     android:layout_width="80dp"
     android:layout_height="63dp"
     android:layout_marginTop="20dp"
     android:layout_marginEnd="108dp"
     android:contentDescription="TODO"
     app:layout_constraintEnd_toEndOf="parent"
     app:layout_constraintTop_toTopOf="parent"
     app:srcCompat="@drawable/hoot_big" />

 <!-- ANR Label -->
 <TextView
     android:id="@+id/textAnr"
     android:layout_width="130dp"
     android:layout_height="59dp"
     android:layout_marginTop="16dp"
     android:text="ANR"
     android:textAppearance="@style/TextAppearance.AppCompat.Large"
     android:textColor="?android:attr/colorFocusedHighlight"
     android:textSize="30sp"
     app:layout_constraintEnd_toEndOf="parent"
     app:layout_constraintHorizontal_bias="0.622"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- System OK Button -->
 <Button
     android:id="@+id/systemOk"
     android:layout_width="100dp"
     android:layout_height="60dp"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="100dp"
     android:clickable="false"
     android:text="System OK"
     android:textSize="@dimen/AnrButtonTextSize"
     android:textStyle="bold"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- Effluent Pump Test Button -->

 <!-- Field Flush Button -->

 <!-- Peristaltic Button -->

 <Button
     android:id="@+id/effPumpTest"
     android:layout_width="@dimen/TestButtonWidth"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:text="Effluent Pump"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toEndOf="@+id/peristalticTest"
     app:layout_constraintTop_toTopOf="@+id/peristalticTest" />

 <Button
     android:id="@+id/ffTest"
     android:layout_width="@dimen/TestButtonWidth"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="32dp"
     android:text="Field Flush"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/peristolticDoseText" />

 <Button
     android:id="@+id/peristalticTest"
     android:layout_width="wrap_content"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:text="Peristaltic"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toEndOf="@+id/ffTest"
     app:layout_constraintTop_toTopOf="@+id/ffTest" />

 <!-- Beeper Silent Button -->

 <!-- Recirculate Button -->

 <!-- Number of Zones -->

 <Button
     android:id="@+id/alarmReset"
     android:layout_width="@dimen/TestButtonWidth"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
    android:text="Alarm Silence"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toEndOf="@+id/recirTest"
     app:layout_constraintTop_toTopOf="@+id/recirTest" />

 <Button
     android:id="@+id/recirTest"
     android:layout_width="wrap_content"
     android:layout_height="@dimen/TestButtonHeight"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:text="Recirculate"
     android:textSize="@dimen/AnrButtonTextSize"
     app:layout_constraintStart_toEndOf="@+id/effPumpTest"
     app:layout_constraintTop_toTopOf="@+id/effPumpTest" />

 <TextView
     android:id="@+id/numberZones"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="12dp"
     android:layout_marginTop="8dp"
     android:gravity="end"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:text="Number of Zones:"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/systemOk" />

 <EditText
     android:id="@+id/zoneCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="1-4"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/numberZones" />

 <!-- Doses Per Day -->
 <TextView
     android:id="@+id/dosesDay"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="@dimen/ANR_MARGIN_START"
     android:layout_marginTop="@dimen/ANR_Top_Margin"
     android:gravity="end"
     android:text="Field Dose Setting per Day"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/numberZones" />

 <EditText
     android:id="@+id/doseDayCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="Number of Doses per Day"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/dosesDay" />

 <!-- Field Dose Runtime mmm:ss -->
 <TextView
     android:id="@+id/FdRunTime"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="@dimen/ANR_MARGIN_START"
     android:layout_marginTop="@dimen/ANR_Top_Margin"
     android:text="Field Dose Run Time (MMM:SS)"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/dosesDay" />

 <EditText
     android:id="@+id/FdRunTimeCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="MMM"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:maxLength="3"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/FdRunTime" />

 <TextView
     android:id="@+id/fdRunColon"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:gravity="center"
     android:paddingStart="4dp"
     android:paddingEnd="4dp"
     android:text=":"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toEndOf="@+id/FdRunTimeCount"
     app:layout_constraintTop_toTopOf="@+id/FdRunTimeCount" />

 <EditText
     android:id="@+id/FdRunTimeCountSec"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:autofillHints=""
     android:gravity="end"
     android:hint="SS"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:maxLength="2"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toEndOf="@+id/fdRunColon"
     app:layout_constraintTop_toTopOf="@+id/FdRunTimeCount" />

 <!-- Recirculate Repeat Time mmm:ss -->
 <TextView
     android:id="@+id/recirRepeatTime"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="16dp"
     android:layout_marginTop="24dp"
     android:text="Recirculate Repeat Cycle (MMM)"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/FdRunTime" />

 <EditText
     android:id="@+id/recirRepeatCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="MMM"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/recirRepeatTime" />


 <!-- Recirculate Runtime -->
 <TextView
     android:id="@+id/recirRunTime"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="16dp"
     android:layout_marginTop="24dp"
     android:text="Recirculate Run Minutes (MMM:SS)"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/recirRepeatTime" />

 <EditText
     android:id="@+id/recirRunCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="MMM"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:maxLength="3"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/recirRunTime" />

 <!-- Air Pressure -->

 <TextView
     android:id="@+id/recirRunCountColon"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:gravity="center"
     android:paddingStart="4dp"
     android:paddingEnd="4dp"
     android:text=":"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toEndOf="@+id/recirRunCount"
     app:layout_constraintTop_toTopOf="@+id/recirRunCount" />

 <EditText
     android:id="@+id/recirRunCountSec"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:autofillHints=""
     android:gravity="end"
     android:hint="SS"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toEndOf="@+id/recirRunCountColon"
     app:layout_constraintTop_toTopOf="@+id/recirRunCount" />

 <TextView
     android:id="@+id/airPressure"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="16dp"
     android:layout_marginTop="24dp"
     android:text="Air Compressor Pressure WCI:"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/recirRunTime" />

 <!-- Effluent Pump Alarm Time -->
 <TextView
     android:id="@+id/effPumpAlarmTime"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="16dp"
     android:layout_marginTop="24dp"
     android:text="Pump Runtime Alarm Minutes:"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/airPressure" />

 <EditText
     android:id="@+id/effPumpAlarmTimeCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="Time to wait before Alarm"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/effPumpAlarmTime" />

 <!-- Carbon (Peristaltic) Dose mmm:ss -->
 <TextView
     android:id="@+id/peristolticDoseText"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:layout_marginStart="16dp"
     android:layout_marginTop="30dp"
     android:text="Carbon Pump Dose (MMM:SS): "
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/effPumpAlarmTime" />

 <EditText
     android:id="@+id/peristolticCount"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:layout_marginStart="@dimen/ANR_EDITTEXT_START"
     android:autofillHints=""
     android:gravity="end"
     android:hint="Carbon Pump Runtime"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="@+id/peristolticDoseText" />

 <TextView
     android:id="@+id/peristolticCountColon"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"
     android:gravity="center"
     android:paddingStart="4dp"
     android:paddingEnd="4dp"
     android:text=":"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toEndOf="@+id/peristolticCount"
     app:layout_constraintTop_toTopOf="@+id/peristolticCount" />

 <EditText
     android:id="@+id/peristolticCountSec"
     android:layout_width="@dimen/anrEditTextWidth"
     android:layout_height="@dimen/anrEditTextHeight"
     android:autofillHints=""
     android:gravity="end"
     android:hint="Seconds"
     android:imeOptions="actionDone"
     android:inputType="number"
     android:textSize="@dimen/anrTextSize"
     app:layout_constraintStart_toEndOf="@+id/peristolticCountColon"
     app:layout_constraintTop_toTopOf="@+id/peristolticCount" />

 <!-- Alarm Latching Button -->
 <Button
     android:id="@+id/alarmLatch"
     android:layout_width="100dp"
     android:layout_height="60dp"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="100dp"
     android:clickable="false"
     android:text="Alarm Latching"
     android:textSize="@dimen/AnrButtonTextSize"
     android:textStyle="bold"
     app:layout_constraintStart_toEndOf="@+id/airAlarm"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- System Alarm Button -->
 <Button
     android:id="@+id/alarm"
     android:layout_width="100dp"
     android:layout_height="60dp"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="100dp"
     android:clickable="false"
     android:text="System Alarm"
     android:textSize="@dimen/AnrButtonTextSize"
     android:textStyle="bold"
     app:layout_constraintStart_toEndOf="@+id/systemOk"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- Water Level Good Button -->
 <Button
     android:id="@+id/waterAlarm"
     android:layout_width="100dp"
     android:layout_height="60dp"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="100dp"
     android:clickable="false"
     android:text="Water Level Good"
     android:textSize="@dimen/AnrButtonTextSize"
     android:textStyle="bold"
     app:layout_constraintStart_toEndOf="@+id/alarm"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- Aeration Problem Button -->
 <Button
     android:id="@+id/airAlarm"
     android:layout_width="100dp"
     android:layout_height="60dp"
     android:layout_marginStart="@dimen/StatusMarginStart"
     android:layout_marginTop="100dp"
     android:text="Aeration Problem"
     android:textSize="@dimen/AnrButtonTextSize"
     android:textStyle="bold"
     app:layout_constraintStart_toEndOf="@+id/waterAlarm"
     app:layout_constraintTop_toTopOf="parent" />

 <!-- Keypad Container -->
 <FrameLayout
     android:id="@+id/keypad_container"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:layout_marginTop="8dp"
     app:layout_constraintEnd_toEndOf="parent"
     app:layout_constraintHorizontal_bias="0.0"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toBottomOf="@+id/ffTest" />

</androidx.constraintlayout.widget.ConstraintLayout>