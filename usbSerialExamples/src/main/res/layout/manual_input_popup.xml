<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <Button
        android:id="@+id/yellowInput"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginStart="16dp"
        android:layout_marginTop="@dimen/manualInputTopMargin"
        android:text="YELLOW Low"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/redInput"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="@dimen/manualInputTopMargin"
        android:text="RED High"
        app:layout_constraintStart_toStartOf="@+id/blueInput"
        app:layout_constraintTop_toBottomOf="@+id/blueInput" />

    <Button
        android:id="@+id/closeManualInputBtn"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="@dimen/manualInputTopMargin"
        android:text="Close"
        app:layout_constraintStart_toStartOf="@+id/redInput"
        app:layout_constraintTop_toBottomOf="@+id/redInput"
        app:layout_goneMarginTop="12dp" />

    <Button
        android:id="@+id/blueInput"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="@dimen/manualInputTopMargin"
        android:text="BLUE Override"
        app:layout_constraintStart_toStartOf="@+id/yellowInput"
        app:layout_constraintTop_toBottomOf="@+id/yellowInput" />

</androidx.constraintlayout.widget.ConstraintLayout>