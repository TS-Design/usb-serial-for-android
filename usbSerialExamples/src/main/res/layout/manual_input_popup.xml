<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <Button
        android:id="@+id/yellowInput"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:text="YELLOW Low"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="3dp" />

    <Button
        android:id="@+id/redInput"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="12dp"
        android:text="RED High"
        app:layout_constraintTop_toBottomOf="@+id/blueInput"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/closeManualInputBtn"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="12dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:text="Close"
        app:layout_constraintTop_toBottomOf="@+id/zone2"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/blueInput"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="12dp"
        android:text="BLUE Override"
        app:layout_constraintTop_toBottomOf="@+id/yellowInput"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/zone1"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="12dp"
        android:text="Zone 1"
        app:layout_constraintTop_toBottomOf="@+id/redInput"
        tools:layout_editor_absoluteX="16dp" />

    <Button
        android:id="@+id/zone2"
        android:layout_width="@dimen/ManualPopUpWidth"
        android:layout_height="@dimen/ManualButtonHeight"
        android:layout_marginTop="12dp"
        android:text="Zone 2"
        app:layout_constraintTop_toBottomOf="@+id/zone1"
        tools:layout_editor_absoluteX="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>